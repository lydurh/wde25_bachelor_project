    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/bun": "latest",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  }
